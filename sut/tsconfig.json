{
  "compilerOptions": {
    "declaration": false,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "outDir": "../.sut-build",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "./src/**/*.ts",
    "./tests/**/*.ts"
  ]
}
