{
  "name": "qa-javascript-book",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:engine": "node scripts/book-engine/generate.mjs",
    "docs:sidebar": "npm run docs:engine && node scripts/generate-sidebar.mjs",
    "docs:dev": "npm run docs:sidebar && vitepress dev .",
    "docs:build": "npm run docs:sidebar && vitepress build .",
    "docs:preview": "vitepress preview .",
    "docs:smoke": "npm run docs:build && node scripts/smoke-build.mjs",
    "docs:qa": "node scripts/book-qa/index.mjs"
  },
  "devDependencies": {
    "mermaid": "^11.16.0",
    "vitepress": "^1.6.4"
  }
}
